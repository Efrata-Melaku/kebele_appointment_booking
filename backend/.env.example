DATABASE_URL="mysql://user:password@localhost:3306/appointment_db"
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"
PORT=5000
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"

# Cloudinary (required for file uploads)
# Use the cloud name from https://console.cloudinary.com (e.g. drkrjwk2w).
# Do NOT use "Root" — that is often confused with the MySQL user in DATABASE_URL.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=kebele/documents

MAX_FILE_SIZE=5242880

# Optional: serve old files still stored under uploads/ (legacy)
SERVE_LEGACY_UPLOADS=false
